# =============================================================================
# 1. CLIENT — à copier dans .env.local (cp .env.example .env.local)
# =============================================================================
# Variables EXPO_PUBLIC_* : elles sont embarquées dans le bundle de l'app, donc
# publiques. N'y mets jamais de secret (clé Anthropic, service role, etc.).
# Pour les builds cloud EAS, définis les mêmes variables avec `eas env:set`
# (voir README, section « Builds EAS ») : .env.local n'est pas envoyé à EAS.

# Supabase (obligatoire : l'app plante au lancement sans ces deux valeurs)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Pages légales (liens ouverts depuis l'inscription et le paywall ; obligatoires pour l'App Store)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Billing mobile (clés SDK publiques RevenueCat)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-android-public-sdk-key

# Crash reporting (DSN Sentry, public)
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn


# =============================================================================
# 2. SERVEUR — secrets Supabase Edge Functions (NE PAS mettre dans .env.local)
# =============================================================================
# Ces lignes sont commentées exprès : elles servent de référence. Définis-les avec
#   supabase secrets set NOM=valeur
# jamais dans .env.local ni dans les variables EAS. Ne mets jamais de clé Anthropic
# dans l'application mobile.
#
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement par Supabase dans les Edge Functions : ne les définis pas
# (les noms commençant par SUPABASE_ sont refusés par `supabase secrets set`).

# Coach IA (obligatoire)
# ANTHROPIC_API_KEY=your-anthropic-server-key
# ANTHROPIC_MODEL_PRIMARY est optionnel (défaut: claude-haiku-4-5-20251001). Le modèle
# doit accepter un tool_choice forcé : refusé par Sonnet 5.5, Opus 5.5 et Fable 5.1.
# ANTHROPIC_MODEL_PRIMARY=claude-haiku-4-5-20251001

# Limite quotidienne d'appels au coach IA par utilisateur (jour Europe/Paris).
# Optionnel, valeurs par défaut ci-dessous. -1 ou unlimited désactive la limite ; toute autre valeur <= 0 est ignorée.
# AI_COACH_DAILY_LIMIT_FREE=3
# AI_COACH_DAILY_LIMIT_PREMIUM=30

# Webhook RevenueCat (fonction revenuecat-webhook)
# REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Catalogue de parcours
# GOLFAPI_KEY=your-golf-provider-key

# Enrichissement open-data GPS via OpenStreetMap / Overpass.
# Utile en fallback ou complément, mais la couverture dépend de la qualité OSM.
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_COURSE_SEARCH_ENABLED=true
# OSM_COURSE_DETAIL_ENABLED=true
# OSM_COURSE_DETAIL_RADIUS_METERS=2500
